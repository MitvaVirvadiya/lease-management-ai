{
  "name": "lease-management-ai",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/agents"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @lease-os/web",
    "dev:api": "npm run start:dev -w @lease-os/api",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate -w @lease-os/api",
    "db:migrate": "npm run db:migrate -w @lease-os/api",
    "db:push": "npm run db:push -w @lease-os/api",
    "db:seed": "npm run db:seed -w @lease-os/api",
    "dev:agents": "npm run dev -w @lease-os/agents",
    "test:agents": "npm run test -w @lease-os/agents",
    "format": "prettier --write apps/agents/src"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
