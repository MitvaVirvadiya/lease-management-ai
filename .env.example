# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Local Docker / Homebrew
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lease_os

# Neon
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Supabase (direct or pooler)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

API_PORT=4005
WEB_ORIGIN=http://localhost:3015
NEXT_PUBLIC_API_URL=http://localhost:4005

# Optional — if unset, extraction and chat use deterministic counsel (labeled in the UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
